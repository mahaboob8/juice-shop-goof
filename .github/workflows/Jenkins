pipeline {
    agent any
    
    tools {
        nodejs 'nodejs@latest' // Use the NodeJS installation configured in Jenkins
    }
    
    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }
        
        stage('Install Dependencies') {
            steps {
                bat 'npm install'
            }
        }
        
        stage('Snyk Security Scan') {
            steps {
                snykSecurity(
                    snykInstallation: 'snyk@latest',
                    snykTokenId: 'snyk-api',
                    severity: 'high',
                    failOnIssues: false,
                    monitorProjectOnBuild: true
                )
            }
        }
    }
}
