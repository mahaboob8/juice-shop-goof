pipeline {
    agent any
    
    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }
        
        stage('Snyk Security Scan') {
            steps {
                snykSecurity(
                    snykInstallation: 'snyk@latest',
                    snykTokenId: 'snyk-api',
                    severity: 'high',
                    failOnIssues: true,
                    monitorProjectOnBuild: true
                )
            }
        }
    }
}
